# Backend environment template
# Copy this file to .env for local development and fill in the real values.

PORT=8080
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional: service account JSON used for Google image generation in production.
# Keep this value as a single-line JSON string if you enable image generation in Render.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
